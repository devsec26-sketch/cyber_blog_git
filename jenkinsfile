pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = "cyber_blog_pipeline_${BUILD_NUMBER}"
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Prepare Environment') {
            steps {
                sh 'cp .env.example .env'
                sh "sed -i 's/DB_HOST=127.0.0.1/DB_HOST=db/g' .env"
                sh "sed -i 's/DB_DATABASE=laravel/DB_DATABASE=cyber_blog/g' .env"
                sh "sed -i 's/DB_USERNAME=root/DB_USERNAME=root/g' .env"
                sh "sed -i 's/DB_PASSWORD=/DB_PASSWORD=root_password/g' .env"
            }
        }

        stage('3. Build & Run Docker Containers') {
            steps {
                // إنشاء شبكة دوكر داخلية لربط الحاويات ببعضها
                sh 'docker network create blog-net || true'
                
                // تشغيل حاوية قاعدة البيانات أولاً بشكل مستقل
                sh 'docker run -d --name db --network blog-net -e MYSQL_DATABASE=cyber_blog -e MYSQL_ROOT_PASSWORD=root_password mysql:8.0'
                
                // بناء صورة التطبيق البرمجية محلياً 
                sh 'docker build -t cyber-blog-app .'
                
                // تشغيل حاوية التطبيق وربطها بالشبكة
                sh 'docker run -d --name app --network blog-net -v "$(pwd):/var/www" cyber-blog-app'
                
                // تشغيل خادم الويب Nginx وتوجيه المنفذ المحلي 8000
                sh 'docker run -d --name webserver --network blog-net -p 8000:80 -v "$(pwd):/var/www" -v "$(pwd)/docker-compose/nginx:/etc/nginx/conf.d/" nginx:alpine'
            }
        }

        stage('4. Install Dependencies') {
            steps {
                // تنفيذ الأوامر داخل الحاوية القياسية بشكل مباشر
                sh 'docker exec -T app composer install'
                sh 'docker exec -T app php artisan key:generate'
            }
        }

        stage('5. Run Migrations & Seeds') {
            steps {
                sh 'sleep 12' 
                sh 'docker exec -T app php artisan migrate:fresh --seed'
            }
        }

        stage('6. Run Unit Tests') {
            steps {
                sh 'docker exec -T app php artisan test'
            }
        }
    }

    post {
        always {
            // إيقاف الحاويات ومسحها لتنظيف الذاكرة بشكل كامل وصحيح
            sh 'docker rm -f webserver app db || true'
            sh 'docker network rm blog-net || true'
        }
        success {
            echo '✅ تم بناء مشروع لارافيل وتشغيل الحاويات واجتياز الاختبارات بنجاح!'
        }
        failure {
            echo '❌ فشل في بناء المشروع، يرجى مراجعة الـ Console Output للتفاصيل.'
        }
    }
}
